<Window
    x:Class="CivVIToolkit.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:localization="using:CivVIToolkit.App.Localization">

    <NavigationView
        x:Name="RootNavigation"
        x:Uid="Navigation_Root"
        PaneTitle="Civ VI Toolkit"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        SelectionChanged="RootNavigation_SelectionChanged">

        <NavigationView.MenuItems>
            <NavigationViewItem x:Uid="Navigation_Overview" Content="Overview" Tag="overview">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="Navigation_Trainer" Content="Trainer" Tag="trainer">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Play" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItemSeparator />
            <NavigationViewItem x:Uid="Navigation_Saves" Content="Save Manager" Tag="saves" />
            <NavigationViewItem x:Uid="Navigation_Maps" Content="Maps &amp; Game Info" Tag="maps" />
            <NavigationViewItem x:Uid="Navigation_Mods" Content="Mod Manager" Tag="mods" />
            <NavigationViewItem x:Uid="Navigation_Launcher" Content="Quick Launch" Tag="launcher" />
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem x:Uid="Navigation_Settings" Content="Settings" Tag="settings">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <NavigationView.Content>
            <Grid Padding="28">
                <ScrollViewer x:Name="OverviewPanel">
                    <StackPanel Spacing="18" MaxWidth="980" HorizontalAlignment="Left">
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="Overview_Title" Text="Civ VI Toolkit" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock x:Uid="Overview_Subtitle" Text="A modular Civilization VI companion for detection, single-player trainer features, saves, mods and launch workflows." Opacity="0.72" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="StatusTitleText" x:Uid="Overview_StatusScanning" Text="Scanning for Civilization VI…" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock x:Name="StatusBadgeText" x:Uid="Overview_StatusDetecting" Text="Detecting Steam / Epic Games and DX11 / DX12" Opacity="0.72" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                    <Button x:Name="DiagnosticsButton" x:Uid="Overview_CopyDiagnostics" Content="Copy diagnostics" Click="DiagnosticsButton_Click" IsEnabled="False" />
                                    <Button x:Name="RefreshButton" x:Uid="Common_Refresh" Content="Refresh" Click="RefreshButton_Click" />
                                </StackPanel>

                                <TextBlock x:Name="DetectionDetailsText" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0" TextWrapping="Wrap" />
                                <TextBlock x:Name="InstallationsText" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0" Opacity="0.66" TextWrapping="Wrap" />
                                <TextBlock x:Name="DiagnosticsStatusText" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0" Opacity="0.66" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel Spacing="5">
                                    <TextBlock x:Uid="Overview_StoreAwareTitle" Text="Store-aware" FontWeight="SemiBold" />
                                    <TextBlock x:Uid="Overview_StoreAwareDescription" Text="Reads Steam library metadata and Epic launcher manifests instead of relying on a fixed install path." Opacity="0.7" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel Spacing="5">
                                    <TextBlock x:Uid="Overview_RendererAwareTitle" Text="Renderer-aware" FontWeight="SemiBold" />
                                    <TextBlock x:Uid="Overview_RendererAwareDescription" Text="Identifies CivilizationVI.exe as DX11 and CivilizationVI_DX12.exe as DX12 at runtime." Opacity="0.7" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel Spacing="5">
                                    <TextBlock x:Uid="Overview_ModuleReadyTitle" Text="Module-ready" FontWeight="SemiBold" />
                                    <TextBlock x:Uid="Overview_ModuleReadyDescription" Text="Trainer, saves, maps, mods and launcher are separated so the toolkit can grow without coupling everything to memory editing." Opacity="0.7" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="TrainerPanel" Visibility="Collapsed">
                    <StackPanel Spacing="16" MaxWidth="980" HorizontalAlignment="Left">
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="Trainer_Title" Text="Single-player Trainer" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock x:Name="TrainerStatusText" x:Uid="Trainer_StatusWaiting" Text="Waiting for Civilization VI." Opacity="0.72" TextWrapping="Wrap" />
                        </StackPanel>

                        <InfoBar x:Uid="Trainer_Info" IsOpen="True" IsClosable="False" Severity="Informational" Title="v0.2 Trainer Core" Message="The exact Steam/DX12 1023995 profile exposes all 22 single-player trainer actions. Click a row or use its global hotkey; unsupported builds fail closed." />

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                            <TextBlock x:Name="TrainerOperationStatusText" x:Uid="Trainer_OperationHint" Text="Click a trainer row or use its global hotkey." Opacity="0.72" TextWrapping="Wrap" />
                        </Border>

                        <ListView x:Name="TrainerList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="TrainerList_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="localization:LocalizedTrainerFeature">
                                    <Grid Padding="4,8" ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="170" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                                            <TextBlock Text="{x:Bind Shortcut}" FontFamily="Cascadia Mono" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Group}" Opacity="0.62" FontSize="12" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Status}" Opacity="0.72" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed">
                    <StackPanel Spacing="18" MaxWidth="760" HorizontalAlignment="Left">
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="Settings_Title" Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock x:Uid="Settings_Description" Text="Configure local CivVIToolkit behavior." Opacity="0.72" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock x:Uid="Settings_LanguageTitle" Text="Language" FontWeight="SemiBold" />
                                    <TextBlock x:Uid="Settings_LanguageDescription" Text="Choose the interface language." Opacity="0.7" TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox x:Name="LanguageComboBox" Grid.Column="1" DisplayMemberPath="DisplayName" SelectionChanged="LanguageComboBox_SelectionChanged" HorizontalAlignment="Stretch" />
                            </Grid>
                        </Border>
                        <InfoBar x:Name="LanguageRestartInfoBar" x:Uid="Settings_RestartInfo" IsOpen="False" IsClosable="True" Severity="Informational" Title="Restart required" Message="Restart CivVIToolkit to fully apply the new language." />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel x:Name="PlaceholderPanel" Visibility="Collapsed" Spacing="8" MaxWidth="760" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <TextBlock x:Name="PlaceholderTitleText" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="PlaceholderDescriptionText" Opacity="0.72" TextWrapping="Wrap" />
                    <InfoBar x:Uid="Placeholder_Info" IsOpen="True" IsClosable="False" Severity="Informational" Title="Planned module" Message="The navigation contract already reserves this module. Implementation will arrive in a later milestone without restructuring the Trainer Core." />
                </StackPanel>
            </Grid>
        </NavigationView.Content>
    </NavigationView>
</Window>
