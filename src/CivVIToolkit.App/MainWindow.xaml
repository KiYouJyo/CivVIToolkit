<Window
    x:Class="CivVIToolkit.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:trainer="using:CivVIToolkit.Core.Trainer">

    <NavigationView
        x:Name="RootNavigation"
        PaneTitle="Civ VI Toolkit"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        SelectionChanged="RootNavigation_SelectionChanged">

        <NavigationView.MenuItems>
            <NavigationViewItem Content="Overview" Tag="overview">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Trainer" Tag="trainer">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Play" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItemSeparator />
            <NavigationViewItem Content="Save Manager" Tag="saves" />
            <NavigationViewItem Content="Maps &amp; Game Info" Tag="maps" />
            <NavigationViewItem Content="Mod Manager" Tag="mods" />
            <NavigationViewItem Content="Quick Launch" Tag="launcher" />
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="Settings" Tag="settings">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <NavigationView.Content>
            <Grid Padding="28">
                <ScrollViewer x:Name="OverviewPanel">
                    <StackPanel Spacing="18" MaxWidth="980" HorizontalAlignment="Left">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Civ VI Toolkit" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock Text="A modular Civilization VI companion for detection, single-player trainer features, saves, mods and launch workflows." Opacity="0.72" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="StatusTitleText" Text="Scanning for Civilization VI…" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock x:Name="StatusBadgeText" Text="Detecting Steam / Epic Games and DX11 / DX12" Opacity="0.72" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                    <Button x:Name="DiagnosticsButton" Content="Copy diagnostics" Click="DiagnosticsButton_Click" IsEnabled="False" />
                                    <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshButton_Click" />
                                </StackPanel>

                                <TextBlock x:Name="DetectionDetailsText" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0" TextWrapping="Wrap" />
                                <TextBlock x:Name="InstallationsText" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0" Opacity="0.66" TextWrapping="Wrap" />
                                <TextBlock x:Name="DiagnosticsStatusText" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0" Opacity="0.66" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Store-aware" FontWeight="SemiBold" />
                                    <TextBlock Text="Reads Steam library metadata and Epic launcher manifests instead of relying on a fixed install path." Opacity="0.7" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Renderer-aware" FontWeight="SemiBold" />
                                    <TextBlock Text="Identifies CivilizationVI.exe as DX11 and CivilizationVI_DX12.exe as DX12 at runtime." Opacity="0.7" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Module-ready" FontWeight="SemiBold" />
                                    <TextBlock Text="Trainer, saves, maps, mods and launcher are separated so the toolkit can grow without coupling everything to memory editing." Opacity="0.7" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="TrainerPanel" Visibility="Collapsed">
                    <StackPanel Spacing="16" MaxWidth="980" HorizontalAlignment="Left">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Single-player Trainer" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock x:Name="TrainerStatusText" Text="Waiting for Civilization VI." Opacity="0.72" TextWrapping="Wrap" />
                        </StackPanel>

                        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="v0.1 trainer core">
                            <InfoBar.Message>
                                The process, memory and AoB scanning layers are in place. Individual game signatures stay disabled until they are verified against real Steam/Epic DX11/DX12 builds.
                            </InfoBar.Message>
                        </InfoBar>

                        <ListView x:Name="TrainerList" SelectionMode="None" IsItemClickEnabled="False">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="trainer:TrainerFeatureDefinition">
                                    <Grid Padding="4,8" ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                                            <TextBlock Text="{x:Bind Shortcut}" FontFamily="Cascadia Mono" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Group}" Opacity="0.62" FontSize="12" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="Signature pending" Opacity="0.62" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel x:Name="PlaceholderPanel" Visibility="Collapsed" Spacing="8" MaxWidth="760" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <TextBlock x:Name="PlaceholderTitleText" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="PlaceholderDescriptionText" Opacity="0.72" TextWrapping="Wrap" />
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Planned module" Message="The navigation contract already reserves this module. Implementation will arrive in a later milestone without restructuring the trainer core." />
                </StackPanel>
            </Grid>
        </NavigationView.Content>
    </NavigationView>
</Window>
